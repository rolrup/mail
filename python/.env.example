# Urbit ship connection
URBIT_URL=http://localhost:8080
URBIT_CODE=sampel-ticlev-migrev-dotnet
URBIT_SHIP=sampel-palnet

# Email domain served by this gateway
MAIL_DOMAIN=mail.example.com

# Shared secret with Cloudflare Worker (for inbound auth)
WORKER_SECRET=your-shared-secret-here

# Outbound email provider: mailgun, mailgun-eu, resend, sendgrid
OUTBOUND_PROVIDER=mailgun-eu
OUTBOUND_API_KEY=key-xxxx:mg.example.com

# Rate limits
RATE_LIMIT_PER_HOUR=30
IP_RATE_LIMIT_PER_HOUR=60
OUTBOUND_RATE_LIMIT_PER_HOUR=10

# Content processing
CONVERT_IMAGES_TO_MD=true

# Server
HOST=0.0.0.0
PORT=8443
